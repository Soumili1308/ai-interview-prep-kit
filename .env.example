# ==========================================
# BACKEND
# ==========================================

PORT=5000

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ai_interview_prep

JWT_SECRET=replace_with_a_long_random_secret

FRONTEND_URL=http://localhost:3000

NODE_ENV=development

# ==========================================
# LLM
# ==========================================

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional public interview-search provider.
# Leave blank to report public discussion as unavailable.
SEARCH_PROVIDER_URL=
SEARCH_PROVIDER_API_KEY=

